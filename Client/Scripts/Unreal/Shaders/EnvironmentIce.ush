// 균열/기포 층을 다른 깊이에서 샘플링해 내부 시차를 보여줘요.
float2 uv=World.xy/max(CellSizeCm,1);
float2 parallax=View.xy/max(abs(View.z),.3)*.012;
float nearLayer=Texture2DSample(Cracks,CracksSampler,uv).r;
float deepLayer=Texture2DSample(Cracks,CracksSampler,uv*1.19+parallax+float2(.31,.17)).r;
float crystals=Texture2DSample(Frost,FrostSampler,uv*6.25).r;
float up=smoothstep(-.12,.9,normalize(WorldNormal).z);
float amount=(Override>=0 ? saturate(Override) : smoothstep(.02,max(FullThicknessMm,.03),max(IceMm,0)));
amount*=saturate(Exposure)*up;
float cold=1-smoothstep(-4,0,Temperature);
float frost=saturate(FrostAmount)*(Override>=0 ? amount : max(amount,cold*saturate(Wetness)*up*saturate(Exposure)));
// 검은 얼음 내부는 어둡게, 공기층/균열은 확산광을 받아 밝게 보여요.
float crack=smoothstep(.16,.8,nearLayer);
float3 ice=lerp(BaseColor*.1,IceTint,.85);
ice+=deepLayer*float3(.075,.115,.13);
ice=lerp(ice,float3(.52,.63,.65),crack*.82);
float3 color=lerp(BaseColor,ice,amount);
float coverage=frost*smoothstep(.08,.6,crystals);
color=lerp(color,float3(.67,.73,.75),coverage);
float rough=lerp(Roughness,.11+nearLayer*.24,amount);
rough=lerp(rough,.76,coverage);
return float4(color,rough);
