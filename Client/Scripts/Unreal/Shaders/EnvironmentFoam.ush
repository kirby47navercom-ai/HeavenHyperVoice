// 기존 Fab의 RGB 마스크를 다른 크기/속도로 샘플링해 큰 거품과 미세 포말을 섞어요.
float2 warp=Texture2DSample(Foam,FoamSampler,UV*.71+float2(.1,.3)).rg-.5;
float3 a=Texture2DSample(Foam,FoamSampler,UV+warp*.1+float2(Age*.025,-Age*.035)).rgb;
float3 b=Texture2DSample(Foam,FoamSampler,UV*3.17+warp*.15+float2(-Age*.04,Age*.02)).rgb;
float density=saturate(a.g*.85+a.r*.45+b.b*.35);
float2 p=UV*2-1;
float edge=1-smoothstep(.55,.98,length(p)+warp.x*.22);
// 두꺼운 흰 부분과 얇은 막을 함께 남겨 선으로만 보이지 않게 해요.
float film=smoothstep(.12,.66,density);
float strength=smoothstep(.005,.3,max(Wave,0));
float alpha=film*edge*strength*Opacity;
return float4(Tint*(.8+.2*b.g),alpha);
