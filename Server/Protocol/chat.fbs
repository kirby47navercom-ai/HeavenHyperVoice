// 채팅 와이어 프로토콜.
// 프레이밍: 4바이트 리틀엔디언 길이 접두사 + 아래 Envelope FlatBuffer.

namespace HeavenChat;

// 클라 -> 서버: 접속 후 반드시 첫 프레임으로 보낸다.
// LoginServer 가 발급한 서명 티켓을 그대로 싣는다.
// 닉네임은 티켓 안에 있다 — 클라이언트가 스스로 주장할 수 없다.
table Hello {
  ticket:[ubyte];
}

// 클라 -> 서버: 채팅 발화.
table Say {
  text:string;
}

// 서버 -> 클라: 입퇴장 등 시스템 알림.
table Notice {
  text:string;
}

// 발화가 속한 채널. 클라이언트의 탭 필터와 발화 대상이 이 값 하나로 정해진다.
//
// 화면의 "전체" 탭은 채널이 아니라 필터다 — 전부 보여 준다. 시스템 알림은
// Notice 로 따로 오므로 여기 없다.
enum Channel : ubyte {
  General = 0,
  Party = 1,

  // 지금 들어와 있는 인스턴스 방 안에서만 오간다. 같은 방 사람에게만 간다.
  Instance = 2
}

// 서버 -> 클라: 다른 참가자의 발화 브로드캐스트.
table Chat {
  nickname:string;
  text:string;

  // 뒤에 붙였다. 안 실어 보내는 구버전 서버의 프레임은 General 로 읽힌다.
  channel:Channel = General;
}

// ------------------------------------------------------------------ 파티
//
// 플레이어 파티(같이 다니는 그룹). 포켓몬 파티와는 다른 것이다.
//
// 파티를 **바꾸는** 명령은 전부 여기 있다. 필드에서든 인스턴스에서든 채팅 연결은
// 살아 있어서 어디서나 파티를 만질 수 있고, 쓰기가 한 서버에만 있으면 경쟁
// 조건도 한 곳에만 생긴다. Field/Instance 는 Redis 를 읽기만 한다.

table PartyMember {
  account_id:ulong;
  nickname:string;
}

// 클라 -> 서버
table PartyInvite        { target_nickname:string; }
table PartyAccept        { party_id:ulong; }
table PartyDecline       { party_id:ulong; }
table PartyLeave         {}
table PartyKick          { target_account:ulong; }
table PartyEnterInstance { instance_type:uint; }
table SayParty           { text:string; }

// 클라 -> 서버. 지금 들어와 있는 인스턴스 방에만 말한다.
// 인스턴스 밖이면 서버가 안내를 돌려준다.
table SayInstance        { text:string; }

// 서버 -> 클라. members 의 순서가 곧 가입 순서이고 첫 번째가 파티장이다.
// 파티장을 가리키는 필드를 따로 두지 않는다 - 두 곳에 적으면 어긋난다.
// party_id 가 0 이면 파티가 없다는 뜻이다.
table PartyState {
  party_id:ulong;
  members:[PartyMember];
  message:string;
}

table PartyInvited       { party_id:ulong; from_nickname:string; }

// 파티장이 입장을 열었다. 받은 클라는 파티장이 아니어도 인스턴스로 넘어간다.
table PartyInstanceReady { instance_type:uint; }

union Payload {
  Hello,
  Say,
  Notice,
  Chat,

  // 새 항목은 언제나 뒤에. 중간에 끼우면 슬롯 번호가 밀려 구버전 클라가
  // 다른 메시지로 읽는다.
  PartyInvite,
  PartyAccept,
  PartyDecline,
  PartyLeave,
  PartyKick,
  PartyEnterInstance,
  SayParty,
  PartyState,
  PartyInvited,
  PartyInstanceReady,
  SayInstance
}

table Envelope {
  payload:Payload;
}

root_type Envelope;
