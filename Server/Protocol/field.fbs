// 필드 와이어 프로토콜. 인스턴스 서버도 같은 것을 쓴다.
//
// 인스턴스는 "야생이 있고 방 번호가 붙은 필드" 라 주고받는 메시지가 같다.
// 스키마를 따로 두면 클라이언트 전송 계층이 한 벌 더 생기고, 둘이 갈라진다.
// 인스턴스에만 있는 것은 Enter.instance_type 과 EnterAck.room_id 둘뿐이다.
//
// 프레이밍은 chat/login 과 동일하다 (4바이트 LE 길이 + Envelope).
//
//   Enter{ticket}  -> EnterAck{entity_id, x, y}   접속 후 첫 프레임
//   Move{x, y}     -> (없음)                       클라 -> 서버, 20Hz
//   (없음)          -> Snapshot                    서버 -> 클라, 20Hz 틱
//
// Spawn/Despawn 은 Snapshot 안에 들어가지만 틱을 기다리지 않고 즉시 나간다.
// Move 가 Spawn 보다 먼저 도착하면 클라가 모르는 엔티티의 좌표를 받게 된다.

namespace HeavenField;

// 클라 -> 서버. LoginServer 가 audience:"field" 로 서명한 티켓을 싣는다.
//
// dev_* 는 서버가 --dev-no-auth 로 떠 있을 때만 읽는다. 그 모드가 아니면
// 존재 자체를 무시하므로, 평소에는 이 필드로 인증을 우회할 수 없다.
// 로그인 서버 없이 필드만 클라이언트와 붙여볼 때 쓴다.
table Enter {
  ticket:[ubyte];

  dev_name:string;
  dev_character_id:ulong;
  dev_partner_species:ushort;

  // 인스턴스 서버 전용. 들어갈 인스턴스 종류다. 필드 서버는 읽지 않는다.
  // 뒤에 붙였다 — 앞에 넣으면 기존 슬롯 번호가 밀려 구버전 클라가 깨진다.
  instance_type:uint;
}

// 서버 -> 클라. 내 엔티티 번호와 시작 위치.
// entity_id 는 character_id 를 그대로 쓴다. 이미 전역 유일하고 계정당 한
// 캐릭터만 접속하므로 별도 매핑이 필요 없다.
table EnterAck {
  entity_id:ulong;
  x:float;
  y:float;
  facing:float;
  map_id:uint;

  // 인스턴스 서버가 배정한 방 번호. 필드는 0 을 보낸다.
  // 클라는 쓰지 않고 로그와 시험 스크립트만 본다 — 같은 종류라도 방이 다르면
  // 서로 안 보이는 것이 정상인지 이 번호로 확인한다.
  room_id:uint;

  // 언리얼 원점이 서버 좌표 어디에 오는가. 클라는 이 값으로 좌표를 옮긴다
  // (서버 = 언리얼 + offset). 필드는 25600, 인스턴스는 월드가 더 커서 다르다.
  //
  // 설정 파일이 아니라 여기로 보내는 이유는, 두 서버의 월드 크기가 다른데
  // 클라 ini 를 손으로 맞추면 언젠가 어긋나기 때문이다. 어긋나면 전원이
  // 엉뚱한 자리에 서는 것으로만 드러나서 찾기가 나쁘다.
  //
  // room_id 뒤에 붙였다. 앞에 끼우면 room_id 의 슬롯 번호가 밀려서, 스키마를
  // 안 따라온 클라나 시험 스크립트가 엉뚱한 값을 읽는다.
  world_origin_offset:float;
}

// 클라 -> 서버. 서버가 직전 위치와 경과 시간으로 속도 상한을 검사한다.
// 높이는 아직 없다. 넣을 때 z 를 뒤에 추가하면 기존 클라와 호환된다.
table Move {
  x:float;
  y:float;
  facing:float;

  // 뒤에 붙였다. 앞에 넣으면 x/y/facing 의 슬롯 번호가 밀려 기존 클라가 깨진다.
  // 서버가 위치를 고쳐야 할 때 이 번호를 그대로 돌려주고, 클라는 그 시점부터
  // 다시 예측한다.
  sequence:uint;
}

// nickname 과 partner_species 는 spawned 에서만 채운다. moved 에 매번 실으면
// 20Hz × 시야 인원만큼 같은 문자열이 흐른다.
table EntityState {
  entity_id:ulong;
  x:float;
  y:float;
  facing:float;
  nickname:string;
  // 파트너의 **도감번호**. 0 이면 파트너 없음.
  partner_species:ushort;

  // 야생 포켓몬의 **도감번호**. 0 이면 플레이어다. spawned 에서만 채운다.
  // 뒤에 붙였다 — 앞에 넣으면 기존 슬롯 번호가 밀려 구버전 클라가 깨진다.
  species:ushort;
}

table Snapshot {
  spawned:[EntityState];
  moved:[EntityState];
  despawned:[ulong];
}

// 서버 -> 클라. 입장 거절 사유 등.
table Notice {
  text:string;
}

// 서버 -> 클라. 보낸 좌표를 서버가 고쳤을 때만, 움직인 본인에게만 간다.
// 정상 이동에 응답하지 않는 이유는 20Hz x 접속자만큼 왕복이 생기기 때문이다.
table Correction {
  sequence:uint;
  x:float;
  y:float;
  facing:float;
}

// 클라 -> 서버. 파티 구성과 꺼낼 한 마리를 정한다.
//
// 로그인 서버가 아니라 여기 있는 이유는, 로그인 연결이 캐릭터 선택 응답 직후
// 닫히기 때문이다. 필드에서 파티를 바꾸려면 필드 연결로 말해야 한다.
//
// character_id 를 싣지 않는다. 서버는 티켓으로 이미 누구인지 알고 있고,
// 클라가 보낸 번호를 받으면 남의 파티를 바꾸려는 시도를 막을 일이 생긴다.
table SetParty {
  dex_numbers:[ushort];
  active_dex:ushort;
}

// 서버 -> 클라. 입장 직후 한 번, SetParty 응답으로 한 번.
//
// 거절이어도 현재 상태를 함께 보낸다. 클라가 실패한 화면을 되돌리려고 따로
// 조회할 필요가 없다.
table PartyState {
  ok:bool;
  message:string;

  // 전부 도감번호다.
  dex_numbers:[ushort];
  active_dex:ushort;
  unlocked:[ushort];
}

// 서버 -> 클라. 시야 안의 누군가가 꺼낸 포켓몬을 바꿨다.
//
// Snapshot 의 partner_species 는 spawned 에만 실린다. 그것만으로는 이미 보고
// 있는 상대가 파트너를 바꿔도 다시 스폰될 때까지 예전 것이 보인다.
table PartnerChanged {
  entity_id:ulong;
  partner_species:ushort;  // 도감번호. 0 이면 도로 넣었다
}

union Payload {
  Enter,
  EnterAck,
  Move,
  Snapshot,
  Notice,
  Correction,
  SetParty,
  PartyState,
  PartnerChanged
}

table Envelope {
  payload:Payload;
}

root_type Envelope;
