// 필드 와이어 프로토콜. 인스턴스 서버도 같은 것을 쓴다.
//
// 인스턴스는 "야생이 있고 방 번호가 붙은 필드" 라 주고받는 메시지가 같다.
// 스키마를 따로 두면 클라이언트 전송 계층이 한 벌 더 생기고, 둘이 갈라진다.
// 인스턴스에만 있는 것은 Enter.instance_type 과 EnterAck.room_id 둘뿐이다.
//
// 프레이밍은 chat/login 과 동일하다 (4바이트 LE 길이 + Envelope).
//
//   Enter{ticket}  -> EnterAck{entity_id, x, y, z} 접속 후 첫 프레임
//   Move{inputs}   -> Correction{sequence, movement} 60Hz 입력을 묶어서 전송
//   (없음)          -> Snapshot                    서버 -> 클라, 20Hz 틱
//
// Spawn/Despawn 은 Snapshot 안에 들어가지만 틱을 기다리지 않고 즉시 나간다.
// Move 가 Spawn 보다 먼저 도착하면 클라가 모르는 엔티티의 좌표를 받게 된다.

namespace HeavenField;

// 뽑기 기계의 타입. 0 은 "안 정했다" 이고 서버가 거절한다 — 기본값이 불꽃이
// 되면 타입을 빠뜨린 클라가 조용히 불꽃을 뽑는다.
// Protocol/GachaPool.h 의 proto::GachaType 과 같은 값이어야 한다.
enum GachaType : ubyte { None = 0, Fire = 1, Water = 2, Grass = 3, Normal = 4, Electric = 5 }

// 클라 -> 서버. LoginServer 가 audience:"field" 로 서명한 티켓을 싣는다.
//
// dev_* 는 서버가 --dev-no-auth 로 떠 있을 때만 읽는다. 그 모드가 아니면
// 존재 자체를 무시하므로, 평소에는 이 필드로 인증을 우회할 수 없다.
// 로그인 서버 없이 필드만 클라이언트와 붙여볼 때 쓴다.
// Shared core state uses Unreal coordinates without a world-origin offset.
table CoreState {
  px:float;
  py:float;
  pz:float;
  vx:float;
  vy:float;
  vz:float;
  ax:float;
  ay:float;
  az:float;
  nx:float;
  ny:float;
  nz:float;
  facing:float;
  mode:ubyte;
  roll_ticks:ushort;
  roll_x:float;
  roll_y:float;
  roll_z:float;
  wall_sliding:bool;
}

table CoreInput {
  sequence:uint;
  x:float;
  y:float;
  buttons:ubyte;
  predicted_x:float;
  predicted_y:float;
  predicted_z:float;
}

table Enter {
  ticket:[ubyte];

  dev_name:string;
  dev_character_id:ulong;
  dev_partner_species:ushort;

  // 인스턴스 서버 전용. 들어갈 인스턴스 종류다. 필드 서버는 읽지 않는다.
  // 뒤에 붙였다 — 앞에 넣으면 기존 슬롯 번호가 밀려 구버전 클라가 깨진다.
  instance_type:uint;
  core_version:uint;
}

// 서버 -> 클라. 내 엔티티 번호와 시작 위치.
// entity_id 는 character_id 를 그대로 쓴다. 이미 전역 유일하고 계정당 한
// 캐릭터만 접속하므로 별도 매핑이 필요 없다.
table EnterAck {
  entity_id:ulong;
  x:float;
  y:float;
  facing:float;
  map_id:uint;

  // 인스턴스 서버가 배정한 방 번호. 필드는 0 을 보낸다.
  // 클라는 쓰지 않고 로그와 시험 스크립트만 본다 — 같은 종류라도 방이 다르면
  // 서로 안 보이는 것이 정상인지 이 번호로 확인한다.
  room_id:uint;

  // 언리얼 원점이 서버 좌표 어디에 오는가. 클라는 이 값으로 좌표를 옮긴다
  // (서버 = 언리얼 + offset). 필드는 25600, 인스턴스는 월드가 더 커서 다르다.
  //
  // 설정 파일이 아니라 여기로 보내는 이유는, 두 서버의 월드 크기가 다른데
  // 클라 ini 를 손으로 맞추면 언젠가 어긋나기 때문이다. 어긋나면 전원이
  // 엉뚱한 자리에 서는 것으로만 드러나서 찾기가 나쁘다.
  //
  // room_id 뒤에 붙였다. 앞에 끼우면 room_id 의 슬롯 번호가 밀려서, 스키마를
  // 안 따라온 클라나 시험 스크립트가 엉뚱한 값을 읽는다.
  world_origin_offset:float;

  // 서버가 공통 코어로 확정한 캡슐 기준 높이다.
  // 뒤에 붙였다. 앞에 넣으면 기존 슬롯 번호가 밀린다.
  z:float;
  core_version:uint;
  collision_hash:ulong;
  movement:CoreState (required);
}

// 클라 -> 서버. 60Hz 입력과 각 입력 직후의 예측 좌표를 순서대로 전송한다.
table Move {
  inputs:[CoreInput] (required);
}

// 캐릭터 외형(커마). login.fbs 의 같은 이름 표와 필드가 1:1 이다.
//
// 스키마가 갈라져 있어 표를 한 번 더 적는다. 하나로 합치려면 field 가 login 을
// include 해야 하는데, 그러면 필드 서버가 쓰지도 않는 로그인 메시지를 통째로
// 끌고 들어온다. C++ 쪽은 proto::AppearanceInfo 하나를 공유하므로 값이 갈릴 일은
// 없다 (Appearance.h).
//
// 옵션을 늘릴 때는 반드시 배열 뒤에 붙일 것 — 부위는 카탈로그의 **인덱스**라
// 중간에 끼워 넣으면 이미 저장된 캐릭터의 머리·옷이 조용히 다른 것이 된다.
table Appearance {
  gender:ubyte;          // 0 = TypeA, 1 = TypeB

  body:int;
  head:int;
  hair:int;
  eye:int;
  equipment:int;

  skin_r:float; skin_g:float; skin_b:float;
  hair_r:float; hair_g:float; hair_b:float;
  eye_r:float;  eye_g:float;  eye_b:float;

  arm_volume:float;
  torso_volume:float;
  leg_volume:float;
}

// nickname 과 partner_species 는 spawned 에서만 채운다. moved 에 매번 실으면
// 20Hz × 시야 인원만큼 같은 문자열이 흐른다. 외형도 같은 이유로 spawned 에만 있다.
table EntityState {
  entity_id:ulong;
  x:float;
  y:float;
  facing:float;
  nickname:string;
  // 파트너의 **도감번호**. 0 이면 파트너 없음.
  partner_species:ushort;

  // 야생 포켓몬의 **도감번호**. 0 이면 플레이어다. spawned 에서만 채운다.
  // 뒤에 붙였다 — 앞에 넣으면 기존 슬롯 번호가 밀려 구버전 클라가 깨진다.
  species:ushort;

  // 야생 포켓몬이 공격을 시작한 틱에만 0 이 아닌 값이 온다.
  // 클라는 같은 번호를 다시 받으면 중복 공격으로 처리하지 않는다.
  attack_sequence:uint;

  // attack_sequence 가 있을 때 바라보거나 맞출 대상 엔티티다.
  attack_target_id:ulong;

  // 서버가 공통 코어로 확정한 캡슐 기준 높이다.
  // 뒤에 붙였다. 앞에 넣으면 기존 슬롯 번호가 밀린다.
  z:float;

  // 플레이어 외형. **spawned 에만 싣는다** — 안 변하는 값이라 매 틱 18개 필드를
  // 사람 수만큼 곱해 보낼 이유가 없다. 야생 포켓몬에는 아예 안 싣는다 (클라가
  // species 로 갈래를 나눠 야생을 다른 컴포넌트로 보내고 거기서는 읽지 않는다).
  //
  // z 보다 뒤다. z 가 먼저 푸시돼서 그 슬롯 번호로 도는 빌드가 이미 있다 —
  // 앞에 끼우면 그쪽이 외형을 높이로 읽는다.
  appearance:Appearance;

  // 서버가 이번 스냅샷 위치를 만들 때 쓴 실제 속도다. 위치처럼 X/Y는 서버
  // 좌표축이고, 속도에는 원점 오프셋을 적용하지 않는다.
  velocity_x:float;
  velocity_y:float;
  velocity_z:float;

  // 야생 포켓몬의 서버 권위 체력. 플레이어 엔티티에서는 둘 다 0이다.
  // 기존 필드의 슬롯 번호를 유지하려고 속도 필드 뒤에 붙인다.
  current_hp:ushort;
  max_hp:ushort;

  // 플레이어가 데리고 다니는 파트너 포켓몬의 서버 권위 위치다. 파트너는 아직
  // 별도 EntityState 가 아니라 주인 엔티티에 붙은 표시 개체라서 여기 싣는다.
  partner_present:bool;
  partner_x:float;
  partner_y:float;
  partner_z:float;
  partner_velocity_x:float;
  partner_velocity_y:float;
  partner_velocity_z:float;
  partner_facing:float;
  partner_teleported:bool;
  movement:CoreState;
  partner_movement:CoreState;
}

table Snapshot {
  spawned:[EntityState];
  moved:[EntityState];
  despawned:[ulong];
  // Monotonic server clock. Clients interpolate by simulation sample time,
  // independently of packet arrival jitter and vertical movement distance.
  server_time_seconds:double;
}

// 서버 -> 클라. 입장 거절 사유 등.
table Notice {
  text:string;
}

// 서버 -> 클라. 검증한 마지막 입력 순번과 전체 상태를 항상 확인 응답한다.
table Correction {
  sequence:uint;
  movement:CoreState (required);
}

// 클라 -> 서버. 파티 구성과 꺼낼 한 마리를 정한다.
//
// 로그인 서버가 아니라 여기 있는 이유는, 로그인 연결이 캐릭터 선택 응답 직후
// 닫히기 때문이다. 필드에서 파티를 바꾸려면 필드 연결로 말해야 한다.
//
// character_id 를 싣지 않는다. 서버는 티켓으로 이미 누구인지 알고 있고,
// 클라가 보낸 번호를 받으면 남의 파티를 바꾸려는 시도를 막을 일이 생긴다.
table SetParty {
  dex_numbers:[ushort];
  active_dex:ushort;
}

// 서버 -> 클라. 입장 직후 한 번, SetParty 응답으로 한 번.
//
// 거절이어도 현재 상태를 함께 보낸다. 클라가 실패한 화면을 되돌리려고 따로
// 조회할 필요가 없다.
table PartyState {
  ok:bool;
  message:string;

  // 전부 도감번호다.
  dex_numbers:[ushort];
  active_dex:ushort;
  unlocked:[ushort];
}

// 서버 -> 클라. 시야 안의 누군가가 꺼낸 포켓몬을 바꿨다.
//
// Snapshot 의 partner_species 는 spawned 에만 실린다. 그것만으로는 이미 보고
// 있는 상대가 파트너를 바꿔도 다시 스폰될 때까지 예전 것이 보인다.
table PartnerChanged {
  entity_id:ulong;
  partner_species:ushort;  // 도감번호. 0 이면 도로 넣었다
}

// 클라 -> 서버. 뽑기 한 번. **타입만** 보낸다.
//
// 무엇이 나오는지는 서버가 정한다. 후보 목록은 클라도 알고 있으므로(확률
// 표시에 쓴다) "후보에 있는가" 만 검증하면 후보 안에서 슈퍼레어를 100%
// 지목하는 치팅을 막을 수 없다.
//
// character_id 를 싣지 않는다 (SetParty 와 같은 이유 — 티켓으로 이미 안다).
table GachaDrawRequest {
  type:GachaType;
}

// 서버 -> 클라. 연출과 결과 화면이 쓴다.
//
// duplicate 가 꽝이다. 이미 해금한 종족이 나오면 토큰은 소모되고 해금은
// 늘지 않는다. 무엇이 나왔는지는 그대로 알려준다 — 숨기면 토큰만 사라진
// 것으로 보인다.
table GachaDrawResponse {
  ok:bool;
  message:string;

  // 나온 종족의 **도감번호**. 실패하면 0.
  dex:ushort;

  // 0 일반 / 1 레어 / 2 슈퍼레어. 캡슐 색이 이걸로 정해진다.
  rarity:ubyte;

  duplicate:bool;
}

// 클라 -> 서버. 토큰 한 개를 준다.
//
// 수급처가 아직 없어서 둔 디버그 경로다. 서버가 --allow-debug-tokens 로 떠
// 있을 때만 처리하고, 아니면 경고를 남기고 버린다.
table DebugGrantToken {
}

// 서버 -> 클라. 지금 토큰 보유량.
//
// PartyState 에 얹지 않은 이유는 PartyState 가 거절 응답으로도 나가기
// 때문이다. 거절 경로는 캐릭터를 읽지 않아서 보유량을 모르고, 그때 0 을
// 실으면 화면이 토큰을 잃은 것으로 본다. 입장할 때 한 번, 보유량이 바뀔
// 때마다 한 번 나간다.
table TokenBalance {
  tokens:uint;
}

union Payload {
  Enter,
  EnterAck,
  Move,
  Snapshot,
  Notice,
  Correction,
  SetParty,
  PartyState,
  PartnerChanged,

  // 뒤에만 붙인다. union 값은 와이어에 나가는 번호라 앞에 끼우면 기존
  // 클라가 프레임을 엉뚱한 타입으로 읽는다.
  GachaDrawRequest,
  GachaDrawResponse,
  DebugGrantToken,
  TokenBalance
}

table Envelope {
  payload:Payload;
}

root_type Envelope;
