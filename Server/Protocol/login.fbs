// 로그인 프로토콜. 프레이밍은 chat 과 동일하다 (4바이트 LE 길이 + Envelope).
//
// 로그인은 한 연결 안에서 2왕복이다.
//
//   LoginRequest          -> LoginResponse{characters[]}      (연결 유지)
//   CreateCharacterRequest -> CreateCharacterResponse         (선택, 연결 유지)
//   SelectCharacterRequest -> SelectCharacterResponse{ticket} (서버가 끊음)
//
// 티켓은 마지막에야 나온다. 어느 캐릭터로 들어가는지 정해져야 발급할 수 있기 때문이다.

namespace HeavenLogin;

// 클라 -> 서버
table LoginRequest {
  username:string;
  password:string;
}

// 클라 -> 서버. 계정만 만든다. 캐릭터는 로그인한 뒤에 만든다.
table RegisterRequest {
  username:string;
  password:string;
}

// 서버 -> 클라. 응답 후 서버가 연결을 끊는다.
// 실패해도 어느 항목이 문제인지 알려준다 — 가입은 로그인과 달리
// 아이디 존재 여부를 숨길 이유가 없다 (어차피 중복이면 못 만든다).
table RegisterResponse {
  ok:bool;
  message:string;
}

// 데리고 다니는 종족. 개체가 아니다.
//
// DB 에 저장되는 것은 "어떤 종족을 골랐는가" 뿐이고, 능력치는 캐릭터 레벨과
// 종족값으로 서버가 계산해 보낸다. 저장해 두면 레벨이 오를 때마다 갱신해야 하고
// 한 군데만 빠뜨려도 조용히 어긋난다.
//
// 현재 체력은 없다. 인스턴스 안에서만 의미가 있어서 Redis 에 있고 여기로 오지 않는다.
table PokemonSummary {
  // 서버 내부 번호. 클라이언트는 이 값으로 에셋을 찾지 않는다 — 배열 순서가
  // 밀리면 다른 종족이 된다. 표시·디버깅용으로만 남긴다.
  species_id:ushort;

  // 개체별 닉네임과 레벨은 없어졌다. 저장하는 것은 종족뿐이고, 레벨은 캐릭터가
  // 갖는다 (CharacterSummary.level).
  //
  // 필드를 지우지 않고 deprecated 로 두는 이유는 슬롯 번호 때문이다. 지우면
  // 뒤 필드가 밀려서 구버전 클라가 엉뚱한 값을 읽는다. 접근자만 사라지므로
  // 이 값을 쓰던 코드는 컴파일에서 걸린다.
  nickname:string (deprecated);
  level:uint (deprecated);

  // 캐릭터 레벨과 종족값으로 계산한 결과. 저장된 값이 아니다.
  max_hp:ushort;
  atk:ushort;
  def:ushort;
  sp_atk:ushort;
  sp_def:ushort;
  speed:ushort;

  // 개체값도 없어졌다. 같은 종족이면 모든 플레이어가 같은 능력치다.
  iv_hp:ubyte (deprecated);
  iv_atk:ubyte (deprecated);
  iv_def:ubyte (deprecated);
  iv_sp_atk:ubyte (deprecated);
  iv_sp_def:ubyte (deprecated);
  iv_speed:ubyte (deprecated);

  // 도감번호. 클라이언트가 종족 에셋을 찾는 열쇠다. 뒤에 붙였다 — 앞에 넣으면
  // 기존 슬롯 번호가 밀려 구버전 클라가 깨진다.
  dex_number:ushort;
}

// 캐릭터 외형(커마). 클라이언트의 FUEHHVAppearance 와 1:1 이다.
//
// 부위는 UUEHHVCustomizationCatalog 배열의 **인덱스**다. 카탈로그 순서를 바꾸거나
// 중간에 끼워 넣으면 이미 저장된 캐릭터의 머리·옷이 조용히 다른 것이 된다.
// 옵션을 늘릴 때는 반드시 배열 뒤에 붙일 것 (PokemonSpecies.h 의 kSpecies 와 같은 제약).
//
// 색을 ubyte 로 압축하지 않고 float 로 두는 이유는, 커마 UI 가 고른 색을
// FLinearColor::Equals(허용 오차 1e-4)로 판정해 선택 표시를 하기 때문이다.
// 8비트로 왕복시키면 오차가 그 이상이라 저장했다 불러올 때 선택이 풀린다.
// 알파는 쓰지 않으므로 싣지 않는다.
table Appearance {
  gender:ubyte;          // 0 = TypeA, 1 = TypeB

  body:int;
  head:int;
  hair:int;
  eye:int;
  equipment:int;

  skin_r:float; skin_g:float; skin_b:float;
  hair_r:float; hair_g:float; hair_b:float;
  eye_r:float;  eye_g:float;  eye_b:float;

  arm_volume:float;
  torso_volume:float;
  leg_volume:float;
}

// 레벨을 갖는 것은 캐릭터다. 포켓몬은 종족이라 자기 레벨이 없고, 데리고 다니는
// 캐릭터의 레벨로 능력치가 정해진다.
table CharacterSummary {
  id:ulong;
  nickname:string;

  // 해금한 종족 중 지금 데리고 다니는 것. 고르지 않았으면 비어 있다.
  partner:PokemonSummary;

  // 뒤에 붙였다. 앞에 넣으면 기존 슬롯 번호가 밀려 구버전 클라가 깨진다.
  appearance:Appearance;

  // 캐릭터 레벨. 데리고 다니는 포켓몬의 능력치가 이 값에서 나온다.
  level:uint;

  // 해금한 것 중 데리고 다니기로 고른 최대 세 마리. 도감번호이고 순서가 곧
  // 슬롯 번호다. partner 는 이 중 지금 꺼내 놓은 한 마리다.
  party:[ushort];

  // 해금한 종족 전부. 파티를 고르는 화면이 후보를 여기서 받는다.
  // 서버가 종족 표에 있는 것만 걸러서 보낸다.
  unlocked:[ushort];
}

// 서버 -> 클라. 여기서는 아직 티켓이 나오지 않는다. 연결은 열린 채로 둔다.
table LoginResponse {
  ok:bool;
  message:string;
  characters:[CharacterSummary];
  max_slots:ubyte;
}

// 클라 -> 서버. 스타터는 서버가 종족 표로 검증한다.
table CreateCharacterRequest {
  nickname:string;

  // 서버 내부 번호. 구버전 클라 호환으로 남겨 둔다. dex_number 가 오면 그쪽이
  // 우선한다.
  species_id:ushort;

  // 커마에서 만든 외형. 없으면 서버가 기본값으로 만든다 — 커마를 건너뛰고
  // 캐릭터만 만드는 경로가 있어도 행이 비어 있지 않게 한다.
  appearance:Appearance;

  // 도감번호. 클라이언트는 이것만 채운다. 뒤에 붙였다.
  dex_number:ushort;
}

// 서버 -> 클라. 생성/삭제/방생이 모두 이걸로 답한다. 셋 다 "무언가 바뀌었으니
// 갱신된 목록을 받아라" 이므로 표를 따로 둘 이유가 없다.
table CharacterListResponse {
  ok:bool;
  message:string;
  characters:[CharacterSummary];
}

// 클라 -> 서버. confirm_nickname 은 사용자가 직접 다시 입력한 값이다.
// character_id 만 믿으면 잘못 누른 한 번으로 다른 캐릭터가 지워진다.
//
// 캐릭터는 행이 지워지지 않고 숨겨진다. 닉네임은 계속 점유된다 — 방금 지워진
// 이름을 남이 바로 가져가면 사칭이 된다.
table DeleteCharacterRequest {
  character_id:ulong;
  confirm_nickname:string;
}

// 클라 -> 서버. 꺼내 놓은 것을 도로 넣는다. 파티와 해금은 그대로다.
table ReleasePartnerRequest {
  character_id:ulong;
}

// 클라 -> 서버. 파티 구성과 꺼낼 한 마리를 한 번에 정한다.
//
// 둘을 나누지 않는 이유는, 파티에서 빼는 순간 꺼내 놓은 것이 파티 밖이 될 수
// 있기 때문이다. 두 요청으로 쪼개면 그 사이에 모순된 상태가 실제로 존재한다.
//
// dex_numbers 는 해금한 종족이어야 하고, 최대 세 개이며 중복이면 거절한다.
// active_dex 는 dex_numbers 안에 있어야 한다. 0 이면 아무도 안 꺼낸다.
table SetPartyRequest {
  character_id:ulong;
  dex_numbers:[ushort];
  active_dex:ushort;
}

// 클라 -> 서버. character_id 는 클라가 보낸 값이지만, 서버는 인증된
// account_id 로 좁혀서 조회하므로 남의 캐릭터는 애초에 찾히지 않는다.
table SelectCharacterRequest {
  character_id:ulong;
}

// 서비스 하나에 붙는 데 필요한 전부. 티켓은 service 별로 따로 서명되므로
// 필드 티켓을 채팅 서버에 낼 수 없다 (audience 검증).
//
// 음성 서버가 생기면 이 목록에 한 줄 늘어날 뿐 프로토콜은 그대로다.
table ServiceEndpoint {
  service:string;   // "field" / "chat" / 추후 "voice"
  host:string;
  port:ushort;
  ticket:[ubyte];
}

// 서버 -> 클라. 응답 후 서버가 연결을 끊는다.
// 붙는 데 필요한 것이 한 프레임에 모인다.
table SelectCharacterResponse {
  ok:bool;
  message:string;

  endpoints:[ServiceEndpoint];

  // 표시용. 권위 있는 값은 티켓 안에 있다.
  nickname:string;
}

union Payload {
  LoginRequest,
  LoginResponse,
  RegisterRequest,
  RegisterResponse,
  CreateCharacterRequest,
  CharacterListResponse,
  SelectCharacterRequest,
  SelectCharacterResponse,
  DeleteCharacterRequest,
  ReleasePartnerRequest,
  SetPartyRequest
}

table Envelope {
  payload:Payload;
}

root_type Envelope;
