#!/bin/sh

# YANG2_CLIENT_AUTHORITY_ONLY
# Yang2를 main에 병합한 상태로 merge commit을 만드는 것을 막는다.

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)

if [ "$branch" = "main" ]; then
    if [ -f "YANG2_ONLY.md" ] || \
       git grep -q "YANG2_CLIENT_AUTHORITY_ONLY" -- \
           'Client/Source/HeavenHyperVoice' '.githooks' 2>/dev/null; then
        echo "ERROR: refusing to merge Yang2 client authority into main." >&2
        echo "Run 'git merge --abort', then merge main into Yang2 instead." >&2
        exit 1
    fi
fi

exit 0
